<clickhouse>
    <!-- ZSTD instead of default LZ4 for all MergeTree parts: ~30-50% smaller on TLC data,
         which is what lets 100M+ trips fit on a laptop disk. -->
    <compression>
        <case>
            <min_part_size>0</min_part_size>
            <min_part_size_ratio>0</min_part_size_ratio>
            <method>zstd</method>
            <level>3</level>
        </case>
    </compression>
</clickhouse>
